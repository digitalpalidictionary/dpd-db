# The change-password service behind /<user>/password/. server_setup.sh fills
# the @...@ values and installs this file. It listens on the unix socket
# /run/dpd-password.sock (0660, chgrp'd to nginx's group at startup), never a
# TCP port. While it is down, every editor location answers 500 (the
# auth_request gate fails closed); systemd revives it within RestartSec.
[Unit]
Description=DPD contributor password change service (unix socket)

[Service]
Type=simple
User=root
WorkingDirectory=@CLONE@
# Run as a module with cwd on sys.path (namespace packages): a direct
# script path would put scripts/server_contrib on sys.path and break the
# repo-standard `from scripts.server_contrib...` import.
ExecStart=@CLONE@/.venv/bin/python -m scripts.server_contrib.password_service
Restart=always
RestartSec=5
MemoryMax=128M

[Install]
WantedBy=multi-user.target
