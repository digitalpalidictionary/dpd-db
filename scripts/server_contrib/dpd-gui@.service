# One gui2 web instance per contributor: systemctl enable --now dpd-gui@<user>
# server_setup.sh fills the @...@ values and installs this file.
# The per-user settings (port, tabs, data folder, bind address) come from
# /etc/dpd/<user>.env, written by add_contributor.sh.
[Unit]
Description=DPD gui2 contributor instance for %i
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
# Mounts the app under /<user>/, where nginx sends that user. Mounted at the
# root, every user's page asks the domain root for its engine files, which only
# one instance can answer, so a second user gets a blank page.
Environment=FLET_WEB_APP_PATH=%i
EnvironmentFile=/etc/dpd/%i.env
WorkingDirectory=@CLONE@
ExecStart=@UV@ run --no-sync python gui2/main.py
# Idle sleep exits with 0 and must come back as an empty process;
# `systemctl stop` (the nightly window) is still final.
Restart=always
RestartSec=10
TimeoutStopSec=30
# One runaway instance must not starve the others. Above MemoryHigh the
# kernel slows it and reclaims; at MemoryMax it is killed, and Restart=always
# brings back an empty process. A warm instance holds about 775 MB.
MemoryHigh=1500M
MemoryMax=2G

[Install]
WantedBy=multi-user.target
