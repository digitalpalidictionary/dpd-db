{#- one full entry per headword: lemma_1 is unique, so the label always resolves -#}
<idx:entry name="Pali" scriptable="yes" spell="yes" id="e{{ data.i.id }}">
    <idx:short>
        <idx:orth value="{{ data.i.lemma_1 }}"><h4 id="hw{{ data.i.id }}">{{ data.i.lemma_1 }}</h4>
            {%- if aliases %}
            <idx:infl>
                {%- for alias in aliases %}
                <idx:iform value="{{ alias }}" exact="yes"></idx:iform>
                {%- endfor %}
            </idx:infl>
            {%- endif %}
        </idx:orth>
        <blockquote><p class="body-space" width="-1em" height="0">{{ data.summary }}</p></blockquote>
        {%- if data.grammar_table %}{{ data.grammar_table }}{%- endif %}
        {%- if data.examples %}{{ data.examples }}{%- endif %}
        {%- if deconstruction %}<p class="body-space">{{ deconstruction }}</p>{%- endif %}
    </idx:short>
</idx:entry>
<hr class="dpd" />
